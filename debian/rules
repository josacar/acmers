#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cargo build --release

override_dh_auto_test:
	cargo test

override_dh_auto_install:
	mkdir -p debian/tmp/usr/bin
	install -m755 target/release/acmers debian/tmp/usr/bin/
	mkdir -p debian/tmp/usr/share/man/man1
	cp debian/acmers.1 debian/tmp/usr/share/man/man1/
	mkdir -p debian/tmp/etc/acmers
	install -m0644 debian/acmers.env.example debian/tmp/etc/acmers/env.example

override_dh_installsystemd:
	dh_installsystemd --no-start acmers.service
	dh_installsystemd acmers.timer
