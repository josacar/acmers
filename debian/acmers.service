[Unit]
Description=acmers certificate renewal
Documentation=man:acmers(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/acmers renew --all
EnvironmentFile=-/etc/acmers/env
StateDirectory=acmers
StateDirectoryMode=0750
PrivateTmp=true
NoNewPrivileges=yes
