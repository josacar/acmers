#!/bin/sh
set -e

case "$1" in
    configure)
        install -d -m 0750 -o root -g root /var/lib/acmers
        install -d -m 0700 -o root -g root /etc/acmers
    ;;
    abort-upgrade|abort-remove|abort-deconfigure)
    ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#
